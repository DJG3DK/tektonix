# Copy to .env and fill in real values. .env is gitignored — never commit it.

LANGGRAPH_PG_DSN=postgresql://user:password@localhost:5432/three_d_agent

MODEL_ROUTER_URL=
MODEL_ROUTER_KEY=

# MODEL_PLAN / MODEL_EXECUTE / MODEL_REFLECT used to be required at startup
# and were never read -- every role routes through the agent-* aliases in
# services/llm-router/config.yaml. REVIEW_GATE_BASE_URL was the same kind of
# leftover (the review gate uses fixed localhost ports 4100/4101).
DEFAULT_BUDGET_USD=5.0
API_PORT=8100

# Where projects may be onboarded from, and where their worktrees are created.
# Onboarding grants an agent bash and write access to what it points at, so
# keep AGENT_PROJECT_ROOTS as narrow as your layout allows (default `/home`).
# AGENT_SANDBOX_ROOT is server-owned and never accepted from a request.
# AGENT_PROJECT_ROOTS=/home
# AGENT_SANDBOX_ROOT=/home/agent-workspaces

# Same-origin by default -- the backend serves the frontend itself. Set this
# (comma-separated) only for a split dev setup with Vite on its own port.
# CORS_ALLOW_ORIGINS=http://localhost:5173

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

LANGCHAIN_OPENAI_STREAM_CHUNK_TIMEOUT_S=30

# AES-GCM key that encrypts TOTP 2FA secrets at rest (agent/auth.py). NOT a
# session key -- sessions are opaque random tokens. Must decode to exactly 16,
# 24, or 32 raw bytes. `openssl rand -hex 32` does NOT work (64 hex chars ->
# 48 bytes -> AESGCM rejects it). Generate with, and never reuse across
# deployments (rotating it makes every stored 2FA secret undecryptable):
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AUTH_SECRET_KEY=

# First admin account (agent/auth.py's seed_admin_if_none): created
# automatically on first startup with a random generated password, printed
# once to the server log with must_change_password set, so it must be
# replaced at first login. Defaults to admin@example.com if unset.
ADMIN_EMAIL=admin@example.com

# SMTP for password-reset emails (agent/mailer.py) -- any standard SMTP
# provider works; this deployment uses Proton Mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Authorises merge/deploy calls from the agent to the review service. Generate
# with: python3 -c "import secrets;print(secrets.token_hex(32))"
# Must match REVIEW_CONTROL_SECRET in services/llm-router/.env. Leave unset if
# you are not running the review services; every merge will then be rejected.
REVIEW_CONTROL_SECRET=

# GitHub (optional). Read-only PR tools for the planner and coder, and the
# fallback token for the GitHub inbox (Settings -> GitHub stores per-project
# tokens encrypted; this one is used by any project without its own). A
# fine-grained PAT with Metadata, Pull requests and Contents read; add
# "Dependabot alerts: read" for security alerts, "Code scanning alerts: read"
# for CodeQL findings, and "Checks: read" or "Actions: read" for failing checks.
GITHUB_TOKEN=
