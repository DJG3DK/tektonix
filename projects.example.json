{
  "projects": {
    "web-app": {
      "sandbox": "/srv/sandboxes/web-app",
      "live": "/srv/live/web-app"
    },
    "api-service": {
      "sandbox": "/srv/sandboxes/api-service",
      "live": "/srv/live/api-service",
      "db_env_file": "config/.env",
      "review": {
        "secretFiles": ["config/auth.json", "config/keys.json"],
        "readOnlyMounts": ["data/cache"],
        "nodeModulesDirs": ["."],
        "checks": [
          { "name": "lint", "dir": ".", "cmd": "npm", "args": ["run", "lint"], "timeoutMs": 300000 },
          { "name": "test", "dir": ".", "cmd": "npm", "args": ["run", "test:review"], "timeoutMs": 900000 }
        ]
      },
      "deploy": {
        "pm2Apps": ["api-service"],
        "build": [{ "dir": ".", "cmd": "npm", "args": ["install", "--no-audit", "--no-fund"] }]
      }
    },
    "worker": {
      "sandbox": "/srv/sandboxes/worker",
      "live": "/srv/live/worker"
    }
  },
  "test_env": {
    "api-service": {
      "EXAMPLE_LIVE_AUTH_FILE": "/srv/live/api-service/config/auth.json"
    }
  }
}
