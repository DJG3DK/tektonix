{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "The app's own page, the control panel: every app command, the plugins it uses, and the window controls. Local pages only; the console at :8100 is console.json.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "updater:default",
    "process:default",
    "dialog:default",
    "opener:default",
    "allow-docker-state",
    "allow-docker-start",
    "allow-docker-install",
    "allow-settings-get",
    "allow-settings-save",
    "allow-machine-git-identity",
    "allow-stack-dir",
    "allow-installed-version",
    "allow-stack-install",
    "allow-stack-up",
    "allow-stack-down",
    "allow-stack-status",
    "allow-stack-password",
    "allow-stack-check-update",
    "allow-stack-update",
    "allow-prefs-get",
    "allow-prefs-set",
    "allow-app-version",
    "allow-app-update-check",
    "allow-app-update-install",
    "allow-auto-update-now",
    "allow-logs-follow",
    "allow-logs-stop",
    "allow-open-console",
    "allow-open-panel",
    "allow-open-projects-dir"
  ]
}
