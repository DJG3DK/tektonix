{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The one window: the app's own page, and the console at localhost:8100 shown in the same window. The console page gets the window controls and the two page switches.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "updater:default",
    "process:default",
    "dialog:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized"
  ],
  "remote": {
    "urls": [
      "http://localhost:8100/*",
      "http://127.0.0.1:8100/*"
    ]
  }
}
